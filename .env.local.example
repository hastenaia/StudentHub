NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth for the Academic Dashboard (see GCP setup below).
# Credentials come from a Google Cloud project → APIs & Services → Credentials
# → OAuth client ID (Web application). Add this redirect URI to the client:
#   http://localhost:3000/api/google/callback  (dev)
#   https://your-app.vercel.app/api/google/callback (prod)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# 32+ character secret used to AES-256-GCM encrypt Google tokens at rest.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value. Rotating it invalidates stored tokens (users
# simply reconnect).
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-random-64-char-hex-string

# AI Study Assistant (Study Hub) — server-side only, never exposed to client.
# Provide ONE of the following (first match wins). If none is set, the Study Hub
# AI tab shows a configuration error instead of fake responses.
# Env vars are read at server start: restart `npm run dev` after editing this file.
# Google / Gemini:
# GOOGLE_AI_API_KEY=...
# GEMINI_API_KEY=...
# Google model selection. Free-tier rate limits make models intermittently return
# 429/503, so the provider tries these in order within one 15s budget.
# GOOGLE_AI_MODEL=gemini-3.6-flash                 # prose: explain, summarize, study-plan
# GOOGLE_AI_STRUCTURED_MODEL=gemini-3.5-flash-lite  # strict JSON: flashcards, quiz
# GOOGLE_AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# On a free tier prefer -flash-lite over flash: flash models are far more contended.
# Alternative providers:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini